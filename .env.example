# ---------------------------------------------------------------------------
# Copie para `.env.local` (desenvolvimento) e cadastre as mesmas variaveis em
# GitLab > Settings > CI/CD > Variables (producao).
# ---------------------------------------------------------------------------

# ID do projeto Sanity (sanity.io/manage > seu projeto > Project ID).
# Ja e o padrao no codigo (src/sanity/env.ts); so preencha para apontar para
# outro projeto, como um de testes.
NEXT_PUBLIC_SANITY_PROJECT_ID=p7j9d06t

# Dataset do Sanity. "production" e o padrao criado junto com o projeto.
NEXT_PUBLIC_SANITY_DATASET=production

# Versao da API do Sanity (data fixa: trava o formato das respostas).
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# URL publica final do blog. Usada em sitemap, RSS, canonical e Open Graph.
NEXT_PUBLIC_SITE_URL=https://blog.traqto.com

# URL do produto Traqto (usada nos CTAs e links internos dos posts).
NEXT_PUBLIC_TRAQTO_URL=https://traqto.com

# ---------------------------------------------------------------------------
# Somente para o job agendado de backup (NAO e usado no build do site).
# Token de leitura criado em sanity.io/manage > API > Tokens (permissao Viewer).
# Cadastrar no GitLab como variavel *masked* e *protected*.
# ---------------------------------------------------------------------------
# SANITY_AUTH_TOKEN=

# Opcional: token de leitura, necessario apenas se o dataset do Sanity for
# privado. Com dataset publico (recomendado para um blog) deixe em branco.
# SANITY_API_READ_TOKEN=
